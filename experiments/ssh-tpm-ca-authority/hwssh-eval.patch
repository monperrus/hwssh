diff --git a/cmd/e2e/main.go b/cmd/e2e/main.go
new file mode 100644
index 0000000..f70866a
--- /dev/null
+++ b/cmd/e2e/main.go
@@ -0,0 +1,125 @@
+// E2E driver (hwssh evaluation): CA + client against one TPM, positive and negative cases.
+// Usage: e2e OUTDIR   (uses /dev/tpmrm0)
+package main
+
+import (
+	"bytes"
+	"crypto/rand"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+
+	keyfile "github.com/foxboron/go-tpm-keyfiles"
+	"github.com/foxboron/ssh-tpm-agent/key"
+	"github.com/foxboron/ssh-tpm-ca-authority/attest"
+	"github.com/foxboron/ssh-tpm-ca-authority/client"
+	"github.com/foxboron/ssh-tpm-ca-authority/server"
+	"github.com/google/go-tpm/tpm2"
+	"github.com/google/go-tpm/tpm2/transport"
+	"golang.org/x/crypto/ssh"
+)
+
+var fails int
+
+func check(name string, ok bool, detail string) {
+	if ok {
+		fmt.Printf("PASS %s\n", name)
+	} else {
+		fails++
+		fmt.Printf("FAIL %s: %s\n", name, detail)
+	}
+}
+
+func must(err error) {
+	if err != nil {
+		fmt.Println("FATAL", err)
+		os.Exit(2)
+	}
+}
+
+func post(url string, v any) []byte {
+	b, _ := json.Marshal(v)
+	rsp, err := http.Post(url, "application/json", bytes.NewBuffer(b))
+	must(err)
+	out, _ := io.ReadAll(rsp.Body)
+	return out
+}
+
+func main() {
+	out := os.Args[1]
+	rwc, err := transport.OpenTPM("/dev/tpmrm0")
+	must(err)
+	defer rwc.Close()
+
+	ekH, _, err := attest.ReadEKCert(rwc)
+	must(err)
+	ekName := fmt.Sprintf("%x", ekH.Name.Buffer)
+	keyfile.FlushHandle(rwc, ekH)
+	fmt.Println("EK name:", ekName)
+
+	ca, err := keyfile.NewLoadableKey(rwc, tpm2.TPMAlgECC, 256, []byte(""))
+	must(err)
+	caPub, err := (&key.SSHTPMKey{TPMKey: ca}).SSHPublicKey()
+	must(err)
+	must(os.WriteFile(filepath.Join(out, "ca.pub"), ssh.MarshalAuthorizedKey(caPub), 0o644))
+
+	other := "000b" + strings.Repeat("00", 32)
+	cfg := &server.Config{Hosts: []*server.HostConf{{
+		Host: "test.local", CaFile: &server.UnmarshalTPMkey{TPMKey: ca},
+		Users: []*server.UsersConf{{User: "alice", EK: ekName}, {User: "mallory", EK: other}},
+	}}}
+	ts := httptest.NewServer(server.NewTPMAttestServer(rwc, cfg).Handlers())
+	defer ts.Close()
+	c := client.NewClient(ts.URL)
+
+	// P1: TPM-bound key, EK listed for alice -> certificate
+	uk, cert, err := c.GetKey(rwc, "alice", "test.local")
+	check("P1 alice gets a certificate for a TPM-bound key", err == nil && cert != nil, fmt.Sprint(err))
+	if err == nil {
+		var buf bytes.Buffer
+		must(keyfile.Encode(&buf, uk))
+		must(os.WriteFile(filepath.Join(out, "id_ecdsa.tpm"), buf.Bytes(), 0o600))
+		must(os.WriteFile(filepath.Join(out, "id_ecdsa-cert.pub"), ssh.MarshalAuthorizedKey(cert), 0o644))
+		check("P1 certificate lifetime is 5 minutes", cert.ValidBefore-cert.ValidAfter == 300,
+			fmt.Sprint(cert.ValidBefore-cert.ValidAfter))
+	}
+
+	// N1: this TPM's EK is not the one listed for mallory
+	_, _, err = c.GetKey(rwc, "mallory", "test.local")
+	check("N1 EK not listed for user -> no certificate", err != nil, "got a certificate")
+
+	newAP := func() *attest.AttestationParameters {
+		k, rsp, err := keyfile.NewLoadableKeyWithResponse(rwc, tpm2.TPMAlgECC, 256, []byte(""))
+		must(err)
+		ap, err := attest.NewAttestationParameters(rwc, k, rsp)
+		must(err)
+		ap.Host, ap.User = "test.local", "alice"
+		return ap
+	}
+
+	// N2: attestation valid but the client cannot decrypt the credential (random secret)
+	ap := newAP()
+	var ch attest.EncryptedCredential
+	must(json.Unmarshal(post(ts.URL+"/attest", ap), &ch))
+	keyfile.FlushHandle(rwc, ap.Handle.Handle)
+	secret := make([]byte, 32)
+	_, _ = rand.Read(secret)
+	body := post(ts.URL+"/submit", client.ChallengeResponse{Secret: secret})
+	check("N2 wrong credential secret -> no certificate", !bytes.Contains(body, []byte("SignedSSHCert")), string(body))
+
+	// N3: key attributes altered after certification (claims fixedTPM it was not certified for)
+	ap = newAP()
+	ap.TPMBoundKey.Public.ObjectAttributes.UserWithAuth = !ap.TPMBoundKey.Public.ObjectAttributes.UserWithAuth
+	body = post(ts.URL+"/attest", ap)
+	keyfile.FlushHandle(rwc, ap.Handle.Handle)
+	check("N3 tampered key public area -> rejected", bytes.Contains(body, []byte("did not validate")), string(body))
+
+	if fails > 0 {
+		os.Exit(1)
+	}
+}
